# 日志
LOG_DIR=./logs
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true

# 文章上传 / 图片上传管理接口的鉴权 Token（请求头 X-Blog-Token）
# 自行生成一串足够长的随机字符串，不要提交真实值
BLOG_ADMIN_TOKEN=change-me-to-a-long-random-string

# 本地开发时由 miaoda 平台下发，通常写在 .env.local 中
# DATABASE_URL=postgres://user:password@host:5432/db
# MIAODA_APP_ID=app_xxxxxxxxxxxx
